{
  "manifest_version": 3,
  "name": "Seller Assistant",
  "version": "1.1.0",
  "description": "Smart-Panel und Auto-Fill Assistent für Verkaufsplattformen",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.ricardo.ch/*",
    "*://*.tutti.ch/*",
    "*://*.ebay.de/*",
    "*://*.kleinanzeigen.de/*",
    "*://*.idealo.de/*",
    "*://*.toppreise.ch/*",
    "*://*.digitec.ch/*"
  ],
  "action": {
    "default_title": "Seller Assistant (Berechtigungen prüfen)"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "*://*.ricardo.ch/*",
        "*://*.tutti.ch/*",
        "*://*.ebay.de/*",
        "*://*.kleinanzeigen.de/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "listing-assistant@local.dev",
      "strict_min_version": "109.0"
    }
  }
}
