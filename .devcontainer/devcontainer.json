{
  "name": "Seller AI Listing Assistant",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--name", "seller-devcontainer",
    "--label", "devcontainer.app=seller"
  ],
  "mounts": [
    {
      "source": "${localEnv:HOME}",
      "target": "/home/vscode",
      "type": "bind",
      "consistency": "cached"
    }
  ],
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode"
}
