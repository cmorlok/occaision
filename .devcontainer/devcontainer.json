{
  "name": "OccAIsion",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--name", "occaision-devcontainer",
    "--label", "devcontainer.app=occaision"
  ],
  // Allow Antigravity CLI (agy) to create nested Linux namespaces (CLONE_NEWUSER/CLONE_NEWNS/CLONE_NEWNET)
  // for its command sandbox inside the Docker Dev Container without failing with 'fork/exec: operation not permitted'.
  "capAdd": [
    "SYS_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "apparmor=unconfined"
  ],
  "mounts": [
    {
      "source": "occaision-devcontainer-home",
      "target": "/home/developer",
      "type": "volume"
    }
  ],
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "developer",
  "containerUser": "developer"
}
